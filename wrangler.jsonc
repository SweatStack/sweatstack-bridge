{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sweatstack-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,

  // Change these here, in your copy. A deploy resets any variable named here to the value here, so one
  // set in the dashboard wouldn't last. The rest of the settings are secrets, because a deploy leaves
  // those alone, even the ones that aren't sensitive. They're listed in .dev.vars.example.
  "vars": {
    "SWEATSTACK_URL": "https://app.sweatstack.no",
    "BACKFILL_DAYS": "90"
  },

  // No database_id: the first deploy provisions the database and the deploy button records its id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sweatstack-bridge",
      "migrations_dir": "migrations"
    }
  ]
}
